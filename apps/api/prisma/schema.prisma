generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE — identidade (não pertence ao G2; reutilizado tal como está)
// ============================================================
enum RoleCode {
  STUDENT
  TEACHER
  TECHNICIAN
  COORDINATOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         RoleCode
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

// ============================================================
// STUBS do G1 (Gestão Académica) — apenas para permitir as FKs
// do G2 enquanto o G1 não entrega o schema definitivo. O G2
// NUNCA deve tratar estes modelos como seus; devem ser
// substituídos/alinhados quando o contrato com o G1 existir.
// ============================================================
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teacherProfiles TeacherProfile[]
}

model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  studentProfiles StudentProfile[]
}

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  enrolments Enrolment[]
}

// ============================================================
// G2 — Estudantes e Docentes
// ============================================================
enum StudentProfileStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

model StudentProfile {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id])
  studentNumber String               @unique
  courseId      String
  course        Course               @relation(fields: [courseId], references: [id])
  admissionYear Int
  phone         String?
  status        StudentProfileStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  enrolments Enrolment[]

  @@index([courseId])
}

enum TeacherProfileStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model TeacherProfile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id])
  staffNumber  String               @unique
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id])
  title        String?
  phone        String?
  status       TeacherProfileStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([departmentId])
}

enum EnrolmentStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

model Enrolment {
  id           String          @id @default(cuid())
  studentId    String
  student      StudentProfile  @relation(fields: [studentId], references: [id])
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  academicYear Int
  status       EnrolmentStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([studentId, subjectId, academicYear])
}

// ============================================================
// CORE — auditoria (reutilizado, não recriado pelo G2)
// ============================================================
model AuditEvent {
  id            String   @id @default(cuid())
  action        String
  resource      String
  resourceId    String
  actorId       String?
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([resource, resourceId])
}
